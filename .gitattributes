# Auto-detect text files and normalise line endings to LF in the repo.
* text=auto eol=lf

# Source code
*.c     text diff=c
*.h     text diff=c

# Build / config
*.cmake text
*.yml   text
*.yaml  text
*.json  text
*.md    text
*.txt   text

# Makefile must use tabs — keep LF
Makefile text eol=lf

# Shell scripts — always LF
*.sh    text eol=lf

# Assembly / fixtures
*.asm   text
*.graph text

# Binary files
*.mgc   binary
*.exe   binary
*.dll   binary
*.so    binary
*.dylib binary
*.a     binary
*.lib   binary
*.o     binary
*.obj   binary
*.pdb   binary
