; Level 0.09: Iterative Fibonacci via loop
; let a=0, b=1, i=0; while(i<10){t=a+b; a=b; b=t; i=i+1}; result=a
; fib(10) = 55
; Expected result: i64(55)
region r0 module
region rl cycle parent=r0
; let a = 0
node ca const_int(0) in r0
node la let(a) in r0
edge e0 ca.out -> la.value
; let b = 1
node cb const_int(1) in r0
node lb let(b) in r0
edge e1 cb.out -> lb.value
; let i = 0
node ci const_int(0) in r0
node li let(i) in r0
edge e2 ci.out -> li.value
; cycle
node cyc cycle in r0 body_region=rl
; break if not(i < 10)
node ir var_ref(i) in rl
node c10 const_int(10) in rl
node cmp lt in rl
edge e3 ir.out -> cmp.lhs
edge e4 c10.out -> cmp.rhs
node inv not in rl
edge e5 cmp.out -> inv.value
node brk break_if in rl
edge e6 inv.out -> brk.cond
; t = a + b (use let for temp)
node ar1 var_ref(a) in rl
node br1 var_ref(b) in rl
node sum add in rl
edge e7 ar1.out -> sum.lhs
edge e8 br1.out -> sum.rhs
node lt2 let(t) in rl
edge e9 sum.out -> lt2.value
; a = b
node br2 var_ref(b) in rl
node sa assign(a) in rl
edge e10 br2.out -> sa.value
; b = t
node tr1 var_ref(t) in rl
node sb assign(b) in rl
edge e11 tr1.out -> sb.value
; i = i + 1
node ir2 var_ref(i) in rl
node c1 const_int(1) in rl
node inc add in rl
edge e12 ir2.out -> inc.lhs
edge e13 c1.out -> inc.rhs
node si assign(i) in rl
edge e14 inc.out -> si.value
; After loop
node ar2 var_ref(a) in r0
root ar2.out
